# ========================================================
# Basic CRM - Environment Variables Configuration (.env.example)
# Rubric requirement: "Keep secrets and deployment settings in environment variables. Do not commit .env"
# ========================================================

# Server Port
PORT=3000

# Environment Mode: 'development' | 'production'
NODE_ENV=development

# JWT Authentication Secret Key
JWT_SECRET=college_crm_jwt_super_secret_key_2026

# MongoDB Atlas Connection String
# Leave empty or unset to use the Dual-Mode In-Memory/Local Persistent Pre-seeded Store
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/college_crm?retryWrites=true&w=majority

# CORS Allowed Origin for Production Deployment (Render + Netlify/Vercel)
CLIENT_ORIGIN=http://localhost:3000

# Application URL
APP_URL=http://localhost:3000

# Gemini API Key (if AI Studio services enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
